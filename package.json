{
    "name": "evo-lib-workspace",
    "version": "11.0.0",
    "private": true,
    "description": "Workspace for evo-lib Angular library",
    "author": "Vladimir Kurguzov <kurguzov74@gmail.com>",
    "scripts": {
        "NODE_MODULES-delete-install": "npm run node_modules-clean && npm run node_modules",
        "DIST-delete-install-watch": "rimraf dist && npm run dist-build:watch",
        "DEMO-SERVE": "ng serve demo --host 0.0.0.0 -o",
        "UPDATE": "npm run DEMO-SERVE && npm run DIST-delete-install-watch",
        "INSTALL:EVO-LIB": "npm install ./dist/evo-lib",
        "EVO:SNIPPETS:modules": "node ./node_modules/evo-lib/tools/install-snippets.js",
        "EVO:SNIPPETS:dist": "node ./dist/evo-lib/tools/install-snippets.js",
        "dist-build": "ng build evo-lib",
        "dist-build:watch": "ng build evo-lib --watch",
        "PUBLISH:PATCH:11-15": "cd projects/evo-lib && npm version patch --no-git-tag-version && cd ../.. && npm run build && npm run publish-dist",
        "PUBLISH:MINOR:11-15": "cd projects/evo-lib && npm version minor --no-git-tag-version && cd ../.. && npm run build && npm run publish-dist",
        "PUBLISH:MAJOR:11-15": "cd projects/evo-lib && npm version major --no-git-tag-version && cd ../.. && npm run build && npm run publish-dist",
        "publish-dist": "npm publish dist/evo-lib --tag ng11-15",
        "ng": "ng",
        "start": "ng serve",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "node_modules-clean": "rimraf node_modules --force || exit 0",
        "node_modules": "npm i",
        "dist-server": "npx http-server dist/evo-lib -p 4344 -o -c-1 --cors"
    },
    "dependencies": {
        "@angular/common": "~11.2.0",
        "@angular/compiler": "~11.2.0",
        "@angular/core": "~11.2.0",
        "@angular/platform-browser": "~11.2.0",
        "@angular/platform-browser-dynamic": "~11.2.0",
        "evo-lib": "file:dist/evo-lib",
        "rxjs": "~6.6.0",
        "tslib": "^2.0.0",
        "zone.js": "~0.11.3"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "~0.1102.18",
        "@angular/cli": "~11.2.0",
        "@angular/compiler-cli": "~11.2.0",
        "@types/jasmine": "~3.6.0",
        "@types/node": "^12.11.1",
        "codelyzer": "^6.0.0",
        "jasmine-core": "~3.6.0",
        "jasmine-spec-reporter": "~5.0.0",
        "karma": "~6.1.0",
        "karma-chrome-launcher": "~3.1.0",
        "karma-coverage": "~2.0.3",
        "karma-jasmine": "~4.0.0",
        "karma-jasmine-html-reporter": "^1.5.0",
        "madge": "^5.0.2",
        "ng-packagr": "^11.0.0",
        "protractor": "~7.0.0",
        "rimraf": "^3.0.2",
        "ts-node": "~8.3.0",
        "tslint": "~6.1.0",
        "typescript": "~4.1.2"
    }
}
