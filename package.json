{
  "name": "evo-lib",
  "version": "11.0.2",
  "description": "Angular library for automating frontend developer work.",
  "author": "Vladimir Kurguzov <kurguzov74@gmail.com>",
  "scripts": {
    "build": "npm run delete-dist && npm run ng build evo-lib",
    "build:watch": "ng build  -- --watch",
    "patch:publish": "npm version patch --no-git-tag-version && cd projects/evo-lib && npm version patch --no-git-tag-version && cd .. && npm run build && npm run publish-dist",
    "publish-dist": "npm publish --tag ng11-15",
    "ng": "ng",
    "start": "ng serve",
    "delete-dist": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmdirSync('dist', { recursive: true });\"",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "~11.2.0",
    "@angular/common": "~11.2.0",
    "@angular/compiler": "~11.2.0",
    "@angular/core": "~11.2.0",
    "@angular/forms": "~11.2.0",
    "@angular/platform-browser": "~11.2.0",
    "@angular/platform-browser-dynamic": "~11.2.0",
    "@angular/router": "~11.2.0",
    "rxjs": "~6.6.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.1102.18",
    "@angular/cli": "~11.2.0",
    "@angular/compiler-cli": "~11.2.0",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.1.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^11.0.0",
    "protractor": "~7.0.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~4.1.2"
  }
}
